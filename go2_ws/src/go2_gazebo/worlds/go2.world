<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="go2_world">
    <!-- 太阳光 + 地面,后续可在此添加障碍物/环境用于导航建图 -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <shadows>false</shadows>
    </scene>
  </world>
</sdf>

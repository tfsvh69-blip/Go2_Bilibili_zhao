<?xml version="1.0"?>
<package format="3">
  <name>go2_unitree_sim_bridge</name>
  <version>0.1.0</version>
  <description>Gazebo/CHAMP 到 Unitree Go2 ROS 2 Sport API 的兼容桥。</description>
  <maintainer email="hao@example.com">hao</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>champ_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>go2_behaviors</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>unitree_go</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

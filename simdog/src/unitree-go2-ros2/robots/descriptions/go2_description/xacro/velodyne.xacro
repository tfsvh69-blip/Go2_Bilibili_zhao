<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <joint name="velodyne_base_mount_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.2 0 0.08"/>
        <parent link="base_link"/>
        <child link="velodyne_base_link"/>
    </joint>
    <link name="velodyne_base_link">
        <inertial>
        <mass value="0.83"/>
        <origin xyz="0 0 0.03585"/>
        <inertia ixx="0.000908059425" ixy="0" ixz="0" iyy="0.000908059425" iyz="0" izz="0.0011049624"/>
        </inertial>
        <visual>
        <geometry>
            <mesh filename="file://$(find velodyne_description)/meshes/VLP16_base_1.dae"/>
        </geometry>
        </visual>
        <visual>
        <geometry>
            <mesh filename="file://$(find velodyne_description)/meshes/VLP16_base_2.dae"/>
        </geometry>
        </visual>
        <collision>
        <origin rpy="0 0 0" xyz="0 0 0.03585"/>
        <geometry>
            <cylinder length="0.0717" radius="0.0516"/>
        </geometry>
        </collision>
    </link>
    <joint name="velodyne_base_scan_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.0377"/>
        <parent link="velodyne_base_link"/>
        <child link="velodyne"/>
    </joint>
    <link name="velodyne">
        <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
        </inertial>
        <visual>
        <origin xyz="0 0 -0.0377"/>
        <geometry>
            <mesh filename="file://$(find velodyne_description)/meshes/VLP16_scan.dae"/>
        </geometry>
        </visual>
    </link>
    <!-- Gazebo requires the velodyne_gazebo_plugins package -->
    <gazebo reference="velodyne">
        <sensor name="velodyne-VLP16" type="gpu_ray">
            <!-- gpu_ray:16×1800=28800条/帧的光线投射交给本机RTX 4060 Laptop GPU，而非拖垮gzserver单线程CPU。
                 若换 gpu_ray 后 /velodyne_points 无数据,把这里改回 "ray" 并将下方 samples 降到 512。 -->
            <!-- 时间错位修复：gpu_ray 是"瞬时全向渲染"，一帧点云几何是渲染过程中某时刻的，
                 但 header.stamp 是渲染结束时刻。机器人旋转/运动时，点云带旧位姿投影到新位姿，
                 远处点产生弧线偏移（偏移≈距离×Δθ），被 costmap 标记成幽灵障碍。
                 水平 samples 1800→900（0.2°→0.4°/条，仍细于 pointcloud_to_laserscan 的 0.5°切片），
                 渲染耗时减半 → 错位窗口减半。真机 VLP-16 为旋转扫描，此改动仅适配 Gazebo gpu_ray。 -->
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>  <!-- 降低更新率以匹配实际情况 -->
            <ray>
                <scan>
                    <horizontal>
                        <samples>900</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>16</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.261799</min_angle>
                        <max_angle>0.261799</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.9</min>
                    <max>100.0</max>
                    <resolution>0.003</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.002</stddev>  <!-- 降低噪声 -->
                </noise>
            </ray>
            <plugin filename="libgazebo_ros_velodyne_laser.so" name="gazebo_ros_laser_controller">
                <ros>
                    <namespace>/</namespace>
                    <remapping>~/out:=/velodyne_points</remapping>
                </ros>
                <frame_name>velodyne</frame_name>
                <organize_cloud>true</organize_cloud>
                <min_range>0.9</min_range>
                <max_range>100.0</max_range>
                <gaussian_noise>0.002</gaussian_noise>
            </plugin>
        </sensor>
    </gazebo>
</robot>

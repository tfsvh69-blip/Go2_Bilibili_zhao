Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.50
    Tree Height: 760
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.50
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Go2 Robot
      Alpha: 0.65
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.45
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Velodyne 3D Points
      Alpha: 0.35
      Autocompute Intensity Bounds: true
      Color Transformer: Intensity
      Decay Time: 0.20
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.015
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /velodyne_points
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Leveled Navigation Scan
      Alpha: 1
      Color: 255; 70; 0
      Decay Time: 0.20
      Position Transformer: XYZ
      Size (Pixels): 4
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Raw Tilting Scan
      Alpha: 0.75
      Color: 255; 0; 170
      Decay Time: 0.20
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.020
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_raw
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Scan Health
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /go2_lidar_scan/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 38; 42
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz_default_plugins/TopDownOrtho
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 8
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 1008
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1220
  X: 80
  Y: 60
